{
  "name": "@agentopsdeck/server",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:history": "tsx benchmarks/history.mts",
    "dev": "tsx watch src/index.ts",
    "test": "node ../../scripts/run-source-tests.mjs server",
    "test:goal-native": "node --import tsx tests/goal-native-contract.mjs",
    "test:goal-lifecycle": "node --import tsx tests/goal-native-lifecycle.mjs",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentopsdeck/shared": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@simplewebauthn/server": "^13.3.2",
    "hono": "^4.13.16",
    "nanoid": "^5.1.16",
    "node-pty": "1.1.0",
    "playwright-core": "1.63.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
